from scapy.all import IP, UDP, Raw, send

# Construction et envoi du paquet forgé
paquet = IP(dst="10.0.0.2") / UDP(sport=31337, dport=31338) / Raw(load=b"FLAG:10.0.0.1:4444")
send(paquet)

print("[+] Paquet Scapy envoyé !")

